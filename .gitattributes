# Các file chạy trên B (Linux) — LUÔN dùng LF, dù checkout trên Windows.
# Nếu để Git đổi sang CRLF, bash/python/suricata trên Linux sẽ lỗi.
*.sh    text eol=lf
*.py    text eol=lf
*.nft   text eol=lf
*.rules text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.conf  text eol=lf
*.service text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
robots.txt text eol=lf

# Script PowerShell chạy trên Windows — giữ CRLF
*.ps1   text eol=crlf

# Nhị phân — không đụng
*.pcap  binary
*.mp4   binary
*.png   binary
*.jpg   binary
*.docx  binary
