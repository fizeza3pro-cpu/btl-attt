# True = co ket noi TCP/application that; False = goi stateless co the gia mao IP.
TCP_EVIDENCE = {sid: sid not in (1000001, 1000003, 1000005) for sid in POLICY_DEFAULTS}


def out(ok, msg, **kw):
    print(json.dumps({"rc": 0 if ok else 1, "msg": msg, **kw}, ensure_ascii=False))
    sys.exit(0 if ok else 1)


def make_rule(kind, content, sid, anchor=False):
    if kind == "uri":
        return (f'alert http any any -> $HOME_NET any (msg:"LAB AUTO uri probe {content}"; '
                f'flow:established,to_server; http.uri; content:"{content}"; nocase; {"startswith; " if anchor else ""}'
                f'classtype:web-application-attack; priority:2; '
                f'metadata:generated_by lab-rulegen, kind uri; sid:{sid}; rev:1;)')
    if kind == "host":
        exact = re.escape(content)
        return (f'alert http any any -> $HOME_NET any (msg:"LAB CUSTOM host {content}"; '
                f'flow:established,to_server; http.host; pcre:"/^{exact}$/i"; '
                f'classtype:web-application-attack; priority:2; '
                f'metadata:generated_by operator, kind host; sid:{sid}; rev:1;)')
    return (f'alert http any any -> $HOME_NET any (msg:"LAB AUTO scanner user-agent {content}"; '
            f'flow:established,to_server; http.user_agent; content:"{content}"; nocase; '
            f'classtype:web-application-attack; priority:2; '
            f'metadata:generated_by lab-rulegen, kind ua; sid:{sid}; rev:1;)')


def valid(kind, content, sid):
    if kind not in RANGES or not isinstance(sid, int) or isinstance(sid, bool):
        return False
    lo, hi = RANGES[kind]
    pat = URI_OK if kind == "uri" else UA_OK
    return lo <= sid <= hi and isinstance(content, str) and bool(pat.match(content))


def valid_custom(kind, content):
    if kind == "uri":
        return isinstance(content, str) and bool(URI_OK.fullmatch(content))
    if kind == "ua":
        return isinstance(content, str) and bool(CUSTOM_UA_OK.fullmatch(content))
    if kind == "host":
        return isinstance(content, str) and bool(HOST_OK.fullmatch(content)) and ".." not in content
    return False


WEBROOT = "/var/www/lab"
REAL_API = ["/api/health", "/api/products", "/api/cart", "/api/order", "/api/login", "/api/logout", "/api/me"]


def clashes_real_path(content):
    """G4 kiem lai bang quyen root: khong tin ket qua cua phieu (proposals.json co the bi sua)."""
    paths = set(REAL_API) | {"/"}
    for root, _d, files in os.walk(WEBROOT):
        for fn in files:
            paths.add("/" + os.path.relpath(os.path.join(root, fn), WEBROOT).replace(os.sep, "/").lower())
    return next((p for p in paths if content in p), None)


def load_active():
    try:
        with open(ACTIVE, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {"rules": []}


def write_atomic(path, text, mode=0o644):
    d = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())                 # chiu duoc tat may dot ngot
    os.chmod(tmp, mode)
    os.replace(tmp, path)
    dfd = os.open(d, os.O_RDONLY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)


def load_policy_document():
    try:
        with open(POLICY_FILE, encoding="utf-8") as f:
            policy = json.load(f)
        return policy if isinstance(policy, dict) else {}
    except (OSError, ValueError):
        return {}


def load_policy():
    rows = load_policy_document().get("rules", {})
    return rows if isinstance(rows, dict) else {}


def policy_threshold_values():
    saved = load_policy_document().get("thresholds", {})
    if not isinstance(saved, dict):
        saved = {}
    try:
        incident = int(saved.get("incident", DEFAULT_THRESHOLDS["incident"]))
        response = int(saved.get("response", DEFAULT_THRESHOLDS["response"]))
    except (TypeError, ValueError):
        return dict(DEFAULT_THRESHOLDS)
    if not (1 <= incident < response <= 500):
        return dict(DEFAULT_THRESHOLDS)
    return {"incident": incident, "response": response}


def save_policy(rows=None, thresholds=None):
    current = load_policy_document()
    data = {
        "version": 2,
        "rules": rows if rows is not None else (current.get("rules", {}) if isinstance(current.get("rules"), dict) else {}),
        "thresholds": thresholds if thresholds is not None else policy_threshold_values(),
    }
    write_atomic(POLICY_FILE, json.dumps(data, ensure_ascii=False, indent=2))


def policy_rows():
    overrides = load_policy()
    try:
        base = open(LOCAL_RULES, encoding="utf-8").read()
    except OSError:
        base = ""
    rows = []
    for sid, default in POLICY_DEFAULTS.items():
        source, description, example = RULE_DETAILS.get(sid, ("Hệ thống", "Sự kiện bảo mật được hệ thống ghi nhận.", "Không có lệnh kiểm thử mẫu"))
        row = {"sid": sid, **default, "default_score": default["score"],
               "default_count": default.get("count"), "default_seconds": default.get("seconds"),
               "match": RULE_MATCHES.get(sid, "Theo sự kiện của hệ thống"), "tcp_evidence": TCP_EVIDENCE[sid],
               "source": source, "description": description, "example": example,
               "default_auto_response": True}
        saved = overrides.get(str(sid), {})
        if isinstance(saved, dict) and isinstance(saved.get("score"), int):
            row["score"] = saved["score"]
        row["auto_response"] = saved.get("auto_response", True) if isinstance(saved, dict) else True
        line = next((x for x in base.splitlines() if f"sid:{sid};" in x), "")
        match = re.search(r"threshold:type both,track by_(?:src|dst),count (\d+),seconds (\d+);", line)
        if match:
            row["count"], row["seconds"] = map(int, match.groups())
        rows.append(row)
    for rule in load_active().get("rules", []):
        sid = rule.get("sid")
        if not isinstance(sid, int) or not 6000000 <= sid <= 6749999:
            continue
        saved = overrides.get(str(sid), {})
        score = saved.get("score", rule.get("score", 50)) if isinstance(saved, dict) else rule.get("score", 50)
        kind = rule.get("kind")
        content = rule.get("content")
        custom_label = {"uri": "URI", "ua": "User-Agent", "host": "Domain/Host"}.get(kind, "mẫu")
        custom_example = ({"uri": f"curl --path-as-is 'http://10.77.0.20{content}'",
                           "ua": f"curl -A '{content}' http://10.77.0.20/",
                           "host": f"curl -H 'Host: {content}' http://10.77.0.20/"}.get(kind, "Gửi request HTTP khớp mẫu"))
        rows.append({"sid": sid, "name": rule.get("name") or rule.get("content", "Rule tùy chỉnh"),
                     "category": "Tùy chỉnh", "score": int(score), "default_score": int(rule.get("score", 50)),
                     "custom": True, "kind": kind, "content": content,
                     "match": f"{({'uri': 'URI chứa', 'ua': 'User-Agent chứa', 'host': 'Domain/Host bằng'}.get(kind, 'Mẫu'))}: {content}",
                     "source": "Suricata · rule do quản trị viên tạo",
                     "description": f"Rule HTTP tùy chỉnh, tạo cảnh báo khi {custom_label} của request khớp giá trị đã nhập.",
                     "example": custom_example,
                     "tcp_evidence": True, "auto_response": saved.get("auto_response", True) if isinstance(saved, dict) else True,
                     "default_auto_response": True})
    return rows


def policy_status():
    out(True, "cấu hình rule đang áp dụng", rules=policy_rows(), thresholds=policy_threshold_values(),
        updated_at=datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds"))


def replace_threshold(text, sid, count, seconds):
    lines = text.splitlines(keepends=True)
    found = False
    for index, line in enumerate(lines):
        if f"sid:{sid};" not in line:
            continue
        pattern = r"threshold:type both,track by_(src|dst),count \d+,seconds \d+;"
        if not re.search(pattern, line):
            out(False, f"rule SID {sid} không có ngưỡng số lượng/thời gian")
        lines[index] = re.sub(pattern, lambda m: f"threshold:type both,track by_{m.group(1)},count {count},seconds {seconds};", line)
        found = True
        break
    if not found:
        out(False, f"không tìm thấy SID {sid} trong local.rules")
    return "".join(lines)


def syntax_base_ok(text):
    with tempfile.TemporaryDirectory(prefix="lab-policy-") as td:
        candidate = os.path.join(td, "local.rules")
        with open(candidate, "w", encoding="utf-8") as f:
            f.write(text)
        r = subprocess.run([SURICATA, "-T", "-c", YAML, "-S", candidate, "-l", td,
                            "--set", "unix-command.enabled=no"], capture_output=True, text=True, timeout=120)
        return r.returncode == 0, (r.stderr or r.stdout)[-500:]


def policy_set(sid, score, count=None, seconds=None, auto_response=None):
    custom = next((r for r in load_active().get("rules", []) if r.get("sid") == sid and 6000000 <= sid <= 6749999), None)
    if (sid not in POLICY_DEFAULTS and custom is None) or not 0 <= score <= 500:
        out(False, "SID hoặc điểm ngoài phạm vi cho phép")
    default = POLICY_DEFAULTS[sid] if sid in POLICY_DEFAULTS else {"score": custom.get("score", 50)}
    has_threshold = "count" in default
    if has_threshold and (count is None or seconds is None or not 1 <= count <= 10000 or not 1 <= seconds <= 3600):
        out(False, "ngưỡng phải có số lượng 1–10000 và thời gian 1–3600 giây")
    if not has_threshold and (count is not None or seconds is not None):
        out(False, "rule này không có ngưỡng đếm trong Suricata")
    if auto_response is not None and not isinstance(auto_response, bool):
        out(False, "tùy chọn tính vào phản ứng không hợp lệ")
    old_rules = open(LOCAL_RULES, encoding="utf-8").read()
    new_rules = replace_threshold(old_rules, sid, count, seconds) if has_threshold else old_rules
    if new_rules != old_rules:
        ok, detail = syntax_base_ok(new_rules)
        if not ok:
            out(False, "Suricata từ chối cấu hình mới; chưa áp dụng", detail=detail)
        write_atomic(LOCAL_RULES, new_rules)
        ok, detail = reload_and_verify()
        if not ok:
            write_atomic(LOCAL_RULES, old_rules)
            sc("reload-rules")
            out(False, "nạp rule thất bại; đã khôi phục cấu hình cũ", detail=detail)
    rows = load_policy()
    current = rows.get(str(sid), {}) if isinstance(rows.get(str(sid)), dict) else {}
    rows[str(sid)] = {**current, "score": score,
                      "auto_response": True if auto_response is None else auto_response,
                      "updated_at": datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")}
    save_policy(rows=rows)
    out(True, f"đã áp dụng SID {sid}", rule=next(r for r in policy_rows() if r["sid"] == sid))


def policy_thresholds(incident, response):
    if not (1 <= incident < response <= 500):
        out(False, "ngưỡng phải thỏa 1 ≤ tạo sự cố < phản ứng tự động ≤ 500")
    values = {"incident": incident, "response": response}
    save_policy(thresholds=values)
    out(True, f"đã đặt ngưỡng sự cố {incident} và ngưỡng phản ứng {response}", thresholds=values)


def mode_status():
    values = {"MODE": "recommend", "RESPONSE": "deceive"}
    try:
        with open(ANALYZER_DEFAULT, encoding="utf-8") as f:
            for line in f:
                key, sep, value = line.strip().partition("=")
                if sep and key in values and value:
                    values[key] = value
    except OSError:
        pass
    return values


def mode_set(profile):
    profiles = {
        "recommend": ("recommend", "deceive", "chỉ đề xuất"),
        "deceive": ("apply", "deceive", "tự đánh lừa"),
        "block": ("apply", "block", "tự chặn web"),
    }
    if profile not in profiles:
        out(False, "chế độ không hợp lệ")
    mode, response, label = profiles[profile]
    previous = mode_status()
    write_atomic(ANALYZER_DEFAULT, f"MODE={mode}\nRESPONSE={response}\n")
    restarted = subprocess.run([SYSTEMCTL, "restart", "lab-analyzer"], capture_output=True, text=True, timeout=30)
    active = subprocess.run([SYSTEMCTL, "is-active", "lab-analyzer"], capture_output=True, text=True, timeout=10)
    if restarted.returncode or active.stdout.strip() != "active":
        write_atomic(ANALYZER_DEFAULT, f"MODE={previous['MODE']}\nRESPONSE={previous['RESPONSE']}\n")
        subprocess.run([SYSTEMCTL, "restart", "lab-analyzer"], capture_output=True, text=True, timeout=30)
        out(False, "restart analyzer thất bại; đã khôi phục chế độ cũ", detail=(restarted.stderr or active.stdout)[-300:])
    out(True, f"đã chuyển sang {label}; điểm trong cửa sổ hiện tại đã được reset", mode=mode, response=response,
        reset_scores=True)


def render(rules):
    head = "# TU SINH boi lab-rulegen, nap boi lab-rule sau khi nguoi van hanh duyet. KHONG sua tay.\n"
    return head + "".join(make_rule(r["kind"], r["content"], r["sid"], r.get("anchor") is True) + "\n" for r in rules)


def syntax_ok(text):
    """Kiem tra local.rules + auto.rules moi cung luc."""
    with tempfile.TemporaryDirectory(prefix="lab-rule-") as td:
        p = os.path.join(td, "all.rules")
        with open(LOCAL_RULES, encoding="utf-8") as f:
            base = f.read()
        with open(p, "w", encoding="utf-8") as f:
            f.write(base + "\n" + text)
        r = subprocess.run([SURICATA, "-T", "-c", YAML, "-S", p, "-l", td, "--set", "unix-command.enabled=no"],
                           capture_output=True, text=True, timeout=120)
        return r.returncode == 0, (r.stderr or r.stdout)[-300:]


def sc(cmd):
    r = subprocess.run([SURICATASC, "-c", cmd], capture_output=True, text=True, timeout=120)
    try:
        return json.loads(r.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        return {"return": "NOK", "message": (r.stdout + r.stderr)[-200:]}


def reload_and_verify():
    r = sc("reload-rules")
    if r.get("return") != "OK":
        return False, f"reload-rules: {r.get('message')}"
    f = sc("ruleset-failed-rules")
    failed = f.get("message") if f.get("return") == "OK" else None
    if isinstance(failed, list) and failed:
        return False, f"co {len(failed)} rule loi sau khi nap"
    st = sc("ruleset-stats")
    return True, st.get("message")


def apply_rules(new_rules, action_msg, extra, policy_updates=None, policy_remove=None):
    old_text = open(AUTO_RULES, encoding="utf-8").read() if os.path.exists(AUTO_RULES) else ""
    text = render(new_rules)
    ok, detail = syntax_ok(text)
    if not ok:
        out(False, "G1 (root): suricata -T báo lỗi, không nạp", detail=detail)
    write_atomic(AUTO_RULES, text)
    ok, detail = reload_and_verify()
    if not ok:                                        # khoi phuc ban truoc
        write_atomic(AUTO_RULES, old_text)
        sc("reload-rules")
        out(False, "nạp thất bại, đã khôi phục auto.rules cũ", detail=detail)
    os.makedirs(STATE_DIR, exist_ok=True)
    write_atomic(ACTIVE, json.dumps({"rules": new_rules}, ensure_ascii=False, indent=1))
    if policy_updates or policy_remove:
        rows = load_policy()
        rows.update(policy_updates or {})
        for sid in policy_remove or []:
            rows.pop(str(sid), None)
        save_policy(rows=rows)
    out(True, action_msg, ruleset=detail, active=len(new_rules), **extra)


def custom_add(kind, content, score, name):
    if not valid_custom(kind, content):
        out(False, "mẫu không hợp lệ; URI phải bắt đầu bằng /; domain chỉ dùng chữ thường, số, dấu chấm và gạch ngang")
    if not 0 <= score <= 500:
        out(False, "điểm phải nằm trong khoảng 0–500")
    name = name.strip()
    if not 3 <= len(name) <= 64 or any(ord(char) < 32 for char in name):
        out(False, "tên rule phải dài 3–64 ký tự và không chứa ký tự điều khiển")
    if kind == "uri" and clashes_real_path(content):
        out(False, f"'{content}' trùng đường dẫn thật của site ({clashes_real_path(content)}) - từ chối")
    active = load_active().get("rules", [])
    if len(active) >= MAX_ACTIVE:
        out(False, "vượt số rule tùy chỉnh/tự sinh tối đa")
    if any(r.get("kind") == kind and str(r.get("content", "")).lower() == content.lower() for r in active):
        out(False, "mẫu này đã có rule đang chạy")
    lo, hi = CUSTOM_RANGES[kind]
    used = {r.get("sid") for r in active if isinstance(r.get("sid"), int)}
    sid = next((candidate for candidate in range(lo, hi + 1) if candidate not in used), None)
    if sid is None:
        out(False, "đã hết dải SID dành cho rule tùy chỉnh")
    now = datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")
    rule = {"sid": sid, "kind": kind, "content": content, "name": name, "score": score,
            "custom": True, "approved_at": now}
    saved = {str(sid): {"score": score, "auto_response": True, "updated_at": now, "name": name}}
    apply_rules(active + [rule], f"đã thêm và nạp rule tùy chỉnh {sid}",
                {"sid": sid, "rule": make_rule(kind, content, sid)}, policy_updates=saved)


def main():
    a = sys.argv[1:]
    if a == ["mode", "status"]:
        out(True, "chế độ analyzer đang áp dụng", **{k.lower(): v for k, v in mode_status().items()})
    if len(a) == 3 and a[:2] == ["mode", "set"]:
        mode_set(a[2])
    if a == ["policy", "status"]:
        policy_status()
    if len(a) == 4 and a[:2] == ["policy", "thresholds"]:
        try:
            policy_thresholds(int(a[2]), int(a[3]))
        except ValueError:
            out(False, "ngưỡng phải là số nguyên")
    if len(a) >= 4 and a[:2] == ["policy", "set"]:
        try:
            sid, score = int(a[2]), int(a[3])
            rest = a[4:]
            count = int(rest[0]) if len(rest) in (2, 3) else None
            seconds = int(rest[1]) if len(rest) in (2, 3) else None
            auto_text = rest[-1] if len(rest) in (1, 3) else None
            if auto_text not in (None, "0", "1"):
                raise ValueError("auto_response")
            auto_response = None if auto_text is None else auto_text == "1"
        except (ValueError, IndexError):
            out(False, "usage: lab-rule policy set <sid> <score> [count seconds] [auto_response]")
        if len(rest) not in (0, 1, 2, 3):
            out(False, "usage: lab-rule policy set <sid> <score> [count seconds] [auto_response]")
        policy_set(sid, score, count, seconds, auto_response)
    if len(a) == 3 and a[:2] == ["policy", "reset"]:
        try:
            sid = int(a[2])
            custom = next((r for r in load_active().get("rules", []) if r.get("sid") == sid and r.get("custom") is True), None)
            default = POLICY_DEFAULTS.get(sid) or ({"score": custom.get("score", 50)} if custom else None)
            if default is None:
                raise KeyError(sid)
        except (ValueError, KeyError):
            out(False, "SID không hợp lệ")
        policy_set(sid, default["score"], default.get("count"), default.get("seconds"), True)
    if len(a) == 6 and a[:2] == ["custom", "add"]:
        try:
            score = int(a[4])
        except ValueError:
            out(False, "điểm phải là số nguyên")
        custom_add(a[2], a[3], score, a[5])
    if a == ["status"]:
        print(json.dumps({"rc": 0, **load_active()}, ensure_ascii=False))
        return
    if len(a) != 2 or a[0] not in ("apply", "revoke"):
        out(False, "usage: lab-rule apply/revoke/status | policy status/set/reset/thresholds | mode status/set | custom add")
    active = load_active().get("rules", [])
    now = datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")

    if a[0] == "apply":
        pid = a[1]
        if not re.fullmatch(r"R5\d{6}", pid):
            out(False, "id khong hop le")
        try:
            with open(PROPOSALS, encoding="utf-8") as f:
                props = json.load(f)
        except (OSError, ValueError):
            out(False, "khong doc duoc proposals.json")
        p = next((x for x in props if isinstance(x, dict) and x.get("id") == pid), None)
        if p is None:
            out(False, "không tìm thấy phiếu")
        if p.get("status") != "pending":
            out(False, f"phiếu không ở trạng thái chờ duyệt ({p.get('status')})")
        kind, content, sid = p.get("kind"), p.get("content"), p.get("sid")
        anchor = p.get("anchor") is True and kind == "uri"      # chi nhan dung kieu bool
        if not valid(kind, content, sid) or pid != f"R{sid}":
            out(False, "phiếu không qua kiểm tra chặt (kind/content/sid) - từ chối")
        if kind == "uri" and clashes_real_path(content):
            out(False, f"G4 (root): '{content}' trùng đường dẫn thật của site ({clashes_real_path(content)}) - từ chối")
        gates = p.get("gates") or {}
        if not all((gates.get(k) or {}).get("ok") for k in ("G1", "G2", "G3", "G4", "G5")):
            out(False, "phiếu chưa đạt đủ 5 cửa kiểm chứng")
        if any(r["sid"] == sid or (r["kind"] == kind and r["content"] == content) for r in active):
            out(False, "rule đã đang chạy")
        if len(active) >= MAX_ACTIVE:
            out(False, "vuot so rule tu sinh toi da")
        new = active + [{"sid": sid, "kind": kind, "content": content, "anchor": anchor, "proposal": pid, "approved_at": now}]
        apply_rules(new, f"đã nạp rule {sid}", {"sid": sid, "rule": make_rule(kind, content, sid, anchor)})
    else:
        if not re.fullmatch(r"[56]\d{6}", a[1]):
            out(False, "sid khong hop le")
        sid = int(a[1])
        if not any(r["sid"] == sid for r in active):
            out(False, "rule không đang chạy")
        custom = any(r.get("sid") == sid and r.get("custom") is True for r in active)
        apply_rules([r for r in active if r["sid"] != sid], f"đã thu hồi rule {sid}", {"sid": sid},
                    policy_remove=[sid] if custom else None)


if __name__ == "__main__":
    main()
